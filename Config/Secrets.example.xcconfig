// Copy to Secrets.xcconfig (git-ignored) and fill in.
// Remember: write URLs as https:/$()/host because `//` starts a comment.

// `supabase status` in the local Docker stack prints this key.
DEV_SUPABASE_ANON_KEY =

STAGING_SUPABASE_URL = https:/$()/vdiheceziirgvbudxdxg.supabase.co
STAGING_SUPABASE_ANON_KEY =

// Production. Only needed for release builds; leave empty on build-loop machines.
PROD_SUPABASE_URL =
PROD_SUPABASE_ANON_KEY =

// Google Sign-In: one iOS OAuth client per bundle id (com.babegetthis.ios[.dev|.staging]),
// from Google Cloud console > Credentials. The reversed id is the client id with its parts
// reversed (com.googleusercontent.apps.<id>). Leave empty and the Google button reports
// that it is not configured. The same client id must be allowed in the Supabase Google provider.
DEV_GOOGLE_IOS_CLIENT_ID =
DEV_GOOGLE_REVERSED_CLIENT_ID =
STAGING_GOOGLE_IOS_CLIENT_ID =
STAGING_GOOGLE_REVERSED_CLIENT_ID =
PROD_GOOGLE_IOS_CLIENT_ID =
PROD_GOOGLE_REVERSED_CLIENT_ID =
