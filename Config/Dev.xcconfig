#include "Shared.xcconfig"

// Local Supabase in Docker + local transcribe stub. The simulator reaches
// the Mac's localhost directly.
BGT_ENVIRONMENT = dev
APP_BUNDLE_ID = com.babegetthis.ios.dev
APP_DISPLAY_NAME = BGT Dev
APP_ICON_NAME = AppIcon-Dev
BGT_SUPABASE_URL = http:/$()/127.0.0.1:54321
BGT_SUPABASE_ANON_KEY = $(DEV_SUPABASE_ANON_KEY)
BGT_API_BASE_URL = http:/$()/127.0.0.1:8080/
BGT_GOOGLE_IOS_CLIENT_ID = $(DEV_GOOGLE_IOS_CLIENT_ID)
BGT_GOOGLE_REVERSED_CLIENT_ID = $(DEV_GOOGLE_REVERSED_CLIENT_ID)
// Dev sends no telemetry (TEL-01).
BGT_FIREBASE_GOOGLE_APP_ID =
BGT_FIREBASE_GCM_SENDER_ID =
BGT_FIREBASE_API_KEY =
BGT_FIREBASE_PROJECT_ID =
BGT_APP_STORE_ID =
