#!/usr/bin/env bash
# Rejects Claude attribution in commit messages (owner rule: no Claude trailers, ever).
if grep -qiE 'co-authored-by|generated with|generated by claude|claude code|noreply@anthropic\.com' "$1"; then
  echo "commit-msg: attribution/trailer text (Co-Authored-By, Generated with, Claude Code) is not allowed in this repo." >&2
  exit 1
fi
